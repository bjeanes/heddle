{
  "heddle": {
    "command": "heddle",
    "args": ["serve", "--eager"],
    "startupTimeout": 120000,
    "extensionToLanguage": {
      ".rb": "ruby",
      ".rake": "ruby",
      ".ru": "ruby",
      ".gemspec": "ruby",
      ".erb": "eruby",
      ".js": "javascript",
      ".mjs": "javascript",
      ".cjs": "javascript",
      ".jsx": "javascriptreact",
      ".ts": "typescript",
      ".mts": "typescript",
      ".cts": "typescript",
      ".tsx": "typescriptreact",
      ".svelte": "svelte",
      ".vue": "vue",
      ".css": "css",
      ".scss": "scss",
      ".html": "html",
      ".json": "json",
      ".yml": "yaml",
      ".yaml": "yaml",
      ".toml": "toml",
      ".md": "markdown",
      ".py": "python",
      ".go": "go",
      ".rs": "rust",
      ".ex": "elixir",
      ".exs": "elixir",
      ".clj": "clojure",
      ".java": "java",
      ".kt": "kotlin",
      ".swift": "swift",
      ".c": "c",
      ".h": "c",
      ".cpp": "cpp",
      ".hpp": "cpp",
      ".sh": "shellscript",
      ".nix": "nix",
      ".lua": "lua",
      ".sql": "sql",
      ".tf": "terraform"
    }
  }
